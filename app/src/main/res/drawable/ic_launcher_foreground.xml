            android:strokeWidth="1.8" />

        <!-- Solid cork with a small highlight instead of a dark center hole. -->
        <path
            android:fillColor="#FFB967"
            android:pathData="M54,62a12,12 0,1 1,0 24a12,12 0,1 1,0 -24" />
        <path
