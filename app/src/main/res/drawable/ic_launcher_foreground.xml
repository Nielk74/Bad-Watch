            android:pathData="M60,66L82.3,35.3"
            android:strokeColor="#3EF2BE"
            android:strokeLineCap="round"
            android:strokeWidth="6.5" />
        <path
            android:fillColor="@android:color/transparent"
            android:pathData="M51,66L38,26.1"
            android:strokeColor="#9CCBFF"
            android:strokeLineCap="round"
            android:strokeWidth="6.5" />
        <path
            android:fillColor="@android:color/transparent"
            android:pathData="M57,66L70,26.1"
            android:strokeColor="#6FE3C1"
            android:strokeLineCap="round"
            android:strokeWidth="6.5" />
